pipeline {
    agent any

    environment {
        APP_DIR = 'Ex09-Jenkins-MultiStage-Pipeline'
        DEPLOY_DIR = 'python-app-deploy'
    }

    stages {
        stage('Build') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                    python3 -m venv venv
                    ./venv/bin/pip install --upgrade pip
                    ./venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir("${APP_DIR}") {
                    echo 'Running tests...'
                    sh './venv/bin/python -m unittest discover -s . -v'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                mkdir -p ${WORKSPACE}/${DEPLOY_DIR}
                cp ${APP_DIR}/app.py ${APP_DIR}/test_app.py ${WORKSPACE}/${DEPLOY_DIR}/
                ls -l ${WORKSPACE}/${DEPLOY_DIR}
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Running application...'
                sh '''
                nohup ${WORKSPACE}/${APP_DIR}/venv/bin/python ${WORKSPACE}/${DEPLOY_DIR}/app.py > ${WORKSPACE}/${DEPLOY_DIR}/app.log 2>&1 &
                echo $! > ${WORKSPACE}/${DEPLOY_DIR}/app.pid
                sleep 3
                cat ${WORKSPACE}/${DEPLOY_DIR}/app.log
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing application...'
                sh '''
                cd ${WORKSPACE}/${DEPLOY_DIR}
                ${WORKSPACE}/${APP_DIR}/venv/bin/python test_app.py
                '''
            }
        }
    }

    post {
        always {
            sh 'kill $(cat ${WORKSPACE}/${DEPLOY_DIR}/app.pid) 2>/dev/null || true'
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
